{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Train Script",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--batch_size",
                "128",
                "--epochs",
                "20",
                "--lr",
                "1e-4",
                "--min_lr",
                "1e-6",
                "--warmup_epochs",
                "5",
                "--weight_decay",
                "1e-4",
                "--pretrain",
                "clipL14commonpool",
                "--num_workers",
                "4",
                "--wandb_team",
                "ece281",
                "--run_name",
                "debug",
                "--exp_name",
                "baseline",
                "--save_dir",
                "checkpoints",
                "--debug",
                "--debug_samples",
                "1000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "CONDA_DEFAULT_ENV": ".venv",
                "CONDA_PREFIX": "${workspaceFolder}/.venv",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
            },
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true
        },
        {
            "name": "Debug Train Script (Full Dataset)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--batch_size",
                "128",
                "--epochs",
                "20",
                "--lr",
                "1e-4",
                "--min_lr",
                "1e-6",
                "--warmup_epochs",
                "5",
                "--weight_decay",
                "1e-4",
                "--pretrain",
                "clipL14commonpool",
                "--num_workers",
                "4",
                "--wandb_team",
                "ece281",
                "--run_name",
                "debug_full",
                "--exp_name",
                "baseline",
                "--save_dir",
                "checkpoints"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "CONDA_DEFAULT_ENV": ".venv",
                "CONDA_PREFIX": "${workspaceFolder}/.venv",
                "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
            },
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true
        }
    ]
}